# ================================================================
# WildBoyz.fun Smart Contracts — Environment Configuration
# ================================================================
#
# PRIVATE KEYS: Stored in Hardhat's encrypted keystore, NOT in .env
#
#   npx hardhat vars set DEPLOYER_PRIVATE_KEY    # Your deploy key
#   npx hardhat vars set UNI_ROUTER_ADDRESS      # Uniswap V2 Router
#   npx hardhat vars set BASE_SEPOLIA_RPC_URL    # Override default RPC
#
#   npx hardhat vars list                        # View all stored vars
#   npx hardhat vars path                        # Where keystore file is
#
# This .env file is ONLY for non-sensitive settings (optional overrides).
# ================================================================

# Optional: Override RPC URLs (defaults are built into hardhat.config.ts)
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Etherscan API keys for contract verification
# BASESCAN_API_KEY=your_basescan_api_key
# ETHERSCAN_API_KEY=your_etherscan_api_key
